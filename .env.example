# GHL OAuth App Credentials
GHL_CLIENT_ID="your_ghl_client_id"
GHL_CLIENT_SECRET="your_ghl_client_secret"

# GHL Shared Secret Key (from Marketplace -> SSO Settings)
GHL_SHARED_SECRET_KEY="your_ghl_shared_secret_key"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GHL_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# GHL API Base URLs (Defaults)
GHL_BASE_URL="https://marketplace.gohighlevel.com"
GHL_API_BASE_URL="https://services.leadconnectorhq.com"
